# Supabase (production / local development)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Mapbox (Obtain from mapbox.com)
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.your-mapbox-token

# App URL (used for auth email redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Gemini (server-side only: never prefix this with NEXT_PUBLIC_)
# Free tier is roughly 20 requests/day on gemini-3.8-flash; the app degrades to
# gemini-3.5-flash-lite and then to the deterministic heuristic.
GEMINI_API_KEY=

# Database migration runner only (npm run db:migrate). Not needed by the app.
# Prefer passing the connection string as an argument instead of storing it here.
DATABASE_URL=
